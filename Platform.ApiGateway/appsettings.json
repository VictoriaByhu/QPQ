{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "catalog-skills": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/skills/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "catalog-tags": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/tags/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "userskills": {
        "ClusterId": "userskills",
        "Match": { "Path": "/api/user-skills/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "userskills-languages": {
        "ClusterId": "userskills",
        "Match": { "Path": "/api/languages/{**catch-all}" },
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "matching-matches": {
        "ClusterId": "matching",
        "Match": { "Path": "/api/matches/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "matching-index-entries": {
        "ClusterId": "matching",
        "Match": { "Path": "/api/index-entries/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "skills", "Version": "v1" }
      },
      "matching-skill-stats": {
        "ClusterId": "matching",
        "Match": { "Path": "/api/skill-stats/{**catch-all}" },
        "Metadata": { "Team": "skills", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "userskills": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://userskills-api" } }
      },
      "matching": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://matching-api" } }
      }
    }
  }
}
