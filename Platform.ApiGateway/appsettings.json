{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" }
      },
      "swaps": {
        "ClusterId": "swaps",
        "Match": { "Path": "/api/swaps/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "swaps", "Version": "v1" }
      },
      "swaps-skills": {
        "ClusterId": "swaps",
        "Match": { "Path": "/api/skills/{**catch-all}" }
      },
      "sessions": {
        "ClusterId": "sessions",
        "Match": { "Path": "/api/sessions/{**catch-all}" }
      },
      "sessions-accepted-swaps": {
        "ClusterId": "sessions",
        "Match": { "Path": "/api/accepted-swaps/{**catch-all}" }
      },
      "messages": {
        "ClusterId": "messages",
        "Match": { "Path": "/api/messages/{**catch-all}" }
      },
      "messages-conversations": {
        "ClusterId": "messages",
        "Match": { "Path": "/api/conversations/{**catch-all}" }
      },
      "messages-attachments": {
        "ClusterId": "messages",
        "Match": { "Path": "/api/attachments/{**catch-all}" }
      }
    },
    "Clusters": {
      "aggregator": {
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "swaps": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://swaps-api" } }
      },
      "sessions": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "d1": { "Address": "http://sessions-api" } }
      },
      "messages": {
        "Destinations": { "d1": { "Address": "http://messages-api" } }
      }
    }
  }
}
